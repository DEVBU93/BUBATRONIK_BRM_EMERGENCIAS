{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmergencyWeatherEvent",
  "description": "Evento unificado: alarma + señal geolocalizada + ping push, para avisos meteorológicos en tiempo real (AEMET/Meteocat).",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "location",
    "alert_level",
    "source",
    "message",
    "push"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "UUID único del evento"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Momento exacto de detección ISO 8601"
    },
    "location": {
      "type": "object",
      "required": [
        "lat",
        "lon",
        "zone_name"
      ],
      "properties": {
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "zone_name": {
          "type": "string",
          "description": "Ej: Sant Salvador, Camp de Tarragona"
        }
      }
    },
    "alert_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Escala Meteocat 1-6 (verde a rojo extremo)"
    },
    "phenomenon": {
      "type": "string",
      "enum": [
        "lluvia",
        "tormenta",
        "viento",
        "nieve",
        "calor",
        "otro"
      ]
    },
    "intensity_mm_h": {
      "type": "number",
      "description": "Intensidad estimada mm/h si aplica"
    },
    "source": {
      "type": "string",
      "enum": [
        "AEMET",
        "Meteocat",
        "ProteccioCivil",
        "sensor_propio"
      ]
    },
    "message": {
      "type": "string",
      "description": "Mensaje corto único combinando alarma+señal"
    },
    "push": {
      "type": "object",
      "required": [
        "sent",
        "channel"
      ],
      "properties": {
        "sent": {
          "type": "boolean"
        },
        "channel": {
          "type": "string",
          "enum": [
            "web_push",
            "telegram",
            "sms",
            "email"
          ]
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "resuelto",
        "expirado"
      ]
    }
  }
}